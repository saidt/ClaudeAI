package VPFDPagedDataSet;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}
{$DESCRIPTION 'TFDQuery-based virtual paging TDataSet for SQL Server (see VPFD.PagedDataSet)'}
{$RUNONLY}

requires
  rtl,
  vcl,
  vcldb,
  FireDAC,
  FireDACCommonDriver,
  FireDACCommon,
  FireDACODBCDriver;

contains
  VPFD.PagedDataSet in '..\src\VPFD.PagedDataSet.pas',
  VPFD.Register in '..\src\VPFD.Register.pas';

end.
